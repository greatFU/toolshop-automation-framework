<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Toolshop Regression Suite"
	parallel="classes"
	thread-count="4">

	<listeners>
		<listener class-name="com.fernandoqa.testcomponents.TestListener" />
	</listeners>

	<test name="Regression Tests">

		<groups>
			<run>
				<include name="regression" />
				<exclude name="knownBug" />
			</run>
		</groups>

		<packages>
			<package name="com.fernandoqa.tests" />
		</packages>

	</test>

</suite>